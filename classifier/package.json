{
  "name": "@anime-filler/classifier",
  "private": true,
  "version": "0.1.0",
  "description": "Hybrid, explainable episode classification service. Feeds the static Anime Filler Finder site.",
  "type": "module",
  "engines": { "node": ">=22.13" },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "tsc -p tsconfig.build.json",
    "cli": "tsx src/cli.ts",
    "dev": "tsx watch src/cli.ts serve",
    "start": "node dist/cli.js serve",
    "worker": "node dist/cli.js worker",
    "backtest": "tsx src/cli.ts backtest"
  },
  "dependencies": {
    "fastify": "^5.0.0",
    "pg": "^8.13.0",
    "pino": "^9.5.0",
    "prom-client": "^15.1.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.0",
    "@electric-sql/pglite-socket": "^0.0.20",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.11.10",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
