# Postgres with the pgvector extension. For local use without Postgres: pglite:./.pgdata
DATABASE_URL=postgres://classifier:change-me@localhost:5432/classifier

# name:role:token, comma separated. Role is admin or reader. Generate tokens with: openssl rand -hex 32
# The name is what appears as the reviewer in the audit log.
API_TOKENS=

PORT=3000
LOG_LEVEL=info

# Set to false when running workers separately.
WORKER=true

CLASSIFIER_ENGINE=hybrid
