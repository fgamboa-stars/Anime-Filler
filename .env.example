# AniList GraphQL endpoint. No API key is required.
VITE_ANILIST_API=https://graphql.anilist.co

# Supabase. The app already reads filler guides from the project's Supabase
# (defaults in src/services/supabase.ts), with the bundled JSON as a fallback.
# Uncomment only to point at a different project. Leaving VITE_SUPABASE_URL
# empty turns Supabase off, so keep these commented out unless you fill them in.
# The anon key is public and read-only.
# VITE_SUPABASE_URL=https://your-project.supabase.co
# VITE_SUPABASE_ANON_KEY=

# Only for `npm run supabase:seed` on your own computer. NEVER add this to
# Vercel or to any VITE_ variable: it bypasses row-level security.
SUPABASE_SERVICE_ROLE_KEY=

# Lets `npm run supabase:seed` write guides through sync_guides() instead of the
# service-role key (this is what the weekly GitHub Action uses).
SUPABASE_SYNC_TOKEN=
